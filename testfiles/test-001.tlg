        id="ID.00437"
        xmlns:Layout="http://iso.org/pdf/ssn/Layout"
        Layout:TextAlign="Justify"
        rolemaps-to="P"
       >
      <?MarkedContent page="2" ?>48. Producto y cociente con exponente: 
      <Formula xmlns="http://iso.org/pdf2/ssn"
         id="ID.00438"
         title="math"
         xmlns:Layout="http://iso.org/pdf/ssn/Layout"
         Layout:Placement="Inline"
        >
       <?MarkedContent page="2" ?>
       <math xmlns="http://www.w3.org/1998/Math/MathML"
          id="ID.00439"
         >
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00440"
           intent=":silent"
           mathvariant="normal"
          >
         <?MarkedContent page="2" ?>⁣
        </mi>
        <mrow xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00441"
           intent="9:number:prefix($next)"
          >
         <mn xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00442"
           >
          <?MarkedContent page="2" ?>9
         </mn>
         <mrow xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00443"
            arg="next"
            intent="_coma:prefix($dp)"
           >
          <mi xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.00444"
             mathvariant="normal"
            >
           <?MarkedContent page="2" ?>,
          </mi>
          <mrow xmlns="http://www.w3.org/1998/Math/MathML"
             id="ID.00445"
             arg="dp"
            >
           <mi xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.00446"
              intent=":silent"
              mathvariant="normal"
             >
            <?MarkedContent page="2" ?>⁣
           </mi>
           <mn xmlns="http://www.w3.org/1998/Math/MathML"
              id="ID.00447"
              intent="8:number"
             >
            <?MarkedContent page="2" ?>8
           </mn>
          </mrow>
         </mrow>
        </mrow>
        <mspace xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00448"
           width="0.167em"
          >
        </mspace>
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00449"
           intent=":unit"
           mathvariant="normal"
          >
         <?MarkedContent page="2" ?>kg
        </mi>
        <mspace xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00450"
           width="0.167em"
          >
        </mspace>
        <mi xmlns="http://www.w3.org/1998/Math/MathML"
