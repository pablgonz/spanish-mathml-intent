           id="ID.00452"
           intent="_por"
           lspace="0"
           rspace="0"
          >
         <?MarkedContent page="2" ?>/
        </mo>
        <msup xmlns="http://www.w3.org/1998/Math/MathML"
           id="ID.00453"
          >
         <mi xmlns="http://www.w3.org/1998/Math/MathML"
            id="ID.00454"
            intent=":unit"
            mathvariant="normal"
           >
          <?MarkedContent page="2" ?>s
