% test-006.lvt -- regresion de los comandos dentro de formulas
%
% Regresion:  l3build save test-006
%             l3build check test-006
%
% Test de regresion del contexto: cada comando junto a otros simbolos
% (igual, suma, desigualdad, fraccion, raiz, otro comando de spintent).
% Comprueba que la anotacion no cambia la lectura de lo que la rodea y que
% los cierres ("fin valor absoluto") aparecen cuando corresponde. Los
% "doc:" son lecturas reales de NVDA 2026.2 con MathCAT,
% tomadas de los tests 021 a 031 que este reemplaza.
\input{regression-test}

